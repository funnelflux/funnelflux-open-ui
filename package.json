{
  "name": "funnelflux-open-ui",
  "private": true,
  "version": "1.1.1",
  "description": "Source-available React admin UI for the FunnelFlux self-hosted tracking platform",
  "license": "Elastic-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/funnelflux/funnelflux-open-ui.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:force": "vite --force",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/check-dist-artifacts.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "build:ci": "pnpm build && pnpm check:bundle",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:openapi": "node scripts/sync-openapi-specs.mjs",
    "sync:stats-openapi": "node scripts/sync-stats-openapi.mjs",
    "generate:stats-types": "pnpm sync:stats-openapi && pnpm generate-types",
    "sync:api": "pnpm generate:stats-types",
    "generate-types": "node scripts/generate-types.mjs",
    "check-generated-types:committed": "node scripts/generate-types.mjs && git diff --exit-code -- src/types/generated",
    "check-generated-types": "pnpm sync:openapi && pnpm check-generated-types:committed"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@date-fns/tz": "^1.5.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.102.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.10",
    "@uiw/codemirror-theme-vscode": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "@xyflow/react": "^12.11.3",
    "antd": "^6.6.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.14",
    "downshift": "^9.4.0",
    "lucide-react": "^0.577.0",
    "qrcode": "1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0",
    "vitest": "^4.1.5",
    "yaml": "^2.8.3"
  },
  "packageManager": "pnpm@10.11.1+sha512.e519b9f7639869dc8d5c3c5dfef73b3f091094b0a006d7317353c72b124e80e1afd429732e28705ad6bfa1ee879c1fce46c128ccebd3192101f43dd67c667912",
  "engines": {
    "node": ">=22"
  }
}
